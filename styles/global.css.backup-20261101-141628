  .aplicacao .home-referencia .home-estatisticas {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto;
    align-content: start;
  }
}

@media (max-width: 700px) {
  .aplicacao .home-referencia .home-estatisticas {
