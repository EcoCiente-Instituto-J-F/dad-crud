:root {
  font-family: Arial, Helvetica, sans-serif;
  color: #0a1027;
  background: #ffffff;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --verde-marca: #064e3b;
  --verde-principal: #0c755b;
  --verde-suave: #e1eddf;
  --texto-secundario: #626a7a;
  --borda: #d8ddd8;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
}

a {
  color: inherit;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid #176baf;
  outline-offset: 4px;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

.aplicacao {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.cabecalho {
  min-height: 128px;
  padding: 32px 50px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.marca {
  position: relative;
  margin-left: 18px;
  color: var(--verde-marca);
  font-family: Georgia, serif;
  font-size: 34px;
  font-weight: 700;
  letter-spacing: -1.5px;
  text-decoration: none;
}

.marca::after {
  content: "";
  position: absolute;
  top: -2px;
  right: 30px;
  width: 16px;
  height: 9px;
  border-radius: 100% 0 100% 0;
  background: var(--verde-marca);
  transform: rotate(-28deg);
}

.perfil {
  min-width: 80px;
  display: grid;
  justify-items: center;
  gap: 7px;
  font-size: 14px;
}

.perfil__avatar {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #f5b82e;
  color: var(--verde-marca);
  font-weight: 700;
}

.estrutura {
  flex: 1;
  display: grid;
  grid-template-columns: 78px minmax(0, 1fr);
  align-items: start;
  gap: clamp(36px, 7.2vw, 104px);
  padding: 26px 50px 48px;
}

.menu-lateral {
  min-height: 650px;
  padding: 48px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28px;
  border-radius: 6px;
  background: var(--verde-suave);
  box-shadow: 0 3px 6px rgb(0 0 0 / 16%);
}

.menu-lateral__link {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: var(--verde-marca);
  text-decoration: none;
  transition:
    background-color 150ms ease,
    color 150ms ease;
}

.menu-lateral__link:hover {
  background: #ccdec9;
}

.menu-lateral__link--ativo,
.menu-lateral__link--ativo:hover {
  color: #ffffff;
  background: var(--verde-principal);
}

.conteudo {
  min-width: 0;
  padding-top: 68px;
  padding-right: 30px;
}

.pagina-cabecalho {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 30px;
}

.pagina-titulo {
  margin-bottom: 8px;
  font-size: 28px;
  line-height: 1.2;
}

.pagina-descricao {
  margin-bottom: 0;
  color: var(--texto-secundario);
  font-size: 15px;
  line-height: 1.6;
}

.painel {
  border: 1px solid var(--borda);
  border-radius: 6px;
  background: #ffffff;
  box-shadow: 0 3px 6px rgb(0 0 0 / 12%);
}

.estado-vazio {
  padding: 48px 28px;
  text-align: center;
}

.estado-vazio h2 {
  font-size: 20px;
}

.estado-vazio p {
  max-width: 480px;
  margin: 0 auto;
  color: var(--texto-secundario);
  line-height: 1.7;
}

.botao {
  min-height: 42px;
  padding: 10px 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid var(--borda);
  border-radius: 5px;
  background: #ffffff;
  color: var(--verde-marca);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
}

.botao--primario {
  border-color: var(--verde-principal);
  background: var(--verde-principal);
  color: #ffffff;
}

.botao--primario:hover {
  background: var(--verde-marca);
}

.mensagem-carregamento {
  padding: 48px;
  color: var(--texto-secundario);
  text-align: center;
}

.pagina-erro {
  padding: 48px 20px;
  text-align: center;
}

.pagina-erro__codigo {
  margin-bottom: 12px;
  color: var(--verde-marca);
  font-size: 72px;
  font-weight: 700;
}

.pagina-erro>p:not(.pagina-erro__codigo) {
  color: var(--texto-secundario);
  line-height: 1.6;
}

.pagina-erro .botao {
  margin-top: 16px;
}

.rodape {
  padding: 18px 24px;
  color: var(--texto-secundario);
  font-size: 12px;
  text-align: center;
}

@media (max-width: 900px) {
  .estrutura {
    gap: 32px;
    padding-right: 24px;
    padding-left: 24px;
  }

  .conteudo {
    padding-right: 0;
  }
}

@media (max-width: 700px) {
  .cabecalho {
    min-height: 100px;
    padding: 24px;
  }

  .marca {
    margin-left: 0;
    font-size: 30px;
  }

  .estrutura {
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding-top: 8px;
  }

  .menu-lateral {
    min-height: auto;
    padding: 12px;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .conteudo {
    padding-top: 0;
  }

  .pagina-cabecalho {
    flex-direction: column;
  }

  .pagina-titulo {
    font-size: 25px;
  }
}

.filtros-usuarios {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) 160px 190px;
  align-items: end;
  gap: 18px;
  margin-bottom: 22px;
}

.campo {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.campo label {
  color: #394052;
  font-size: 13px;
  font-weight: 600;
}

.campo select,
.campo-pesquisa {
  width: 100%;
  min-height: 44px;
  border: 1px solid #b8c0bb;
  border-radius: 8px;
  background: #ffffff;
  color: #394052;
}

.campo select {
  padding: 0 12px;
}

.campo-pesquisa {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 14px;
  color: var(--texto-secundario);
}

.campo-pesquisa input {
  width: 100%;
  min-width: 0;
  min-height: 42px;
  border: 0;
  background: transparent;
  color: #242a3a;
}

.campo-pesquisa:focus-within {
  outline: 3px solid #176baf;
  outline-offset: 3px;
}

.campo-pesquisa input:focus-visible {
  outline: none;
}

.campo-pesquisa input::placeholder {
  color: #6b7280;
}

.resultado-carregamento {
  margin: 0;
  padding: 14px 18px;
  border-bottom: 1px solid var(--borda);
  background: #f6f9f5;
  color: var(--verde-marca);
  font-size: 13px;
}

.tabela-container {
  width: 100%;
  overflow-x: auto;
}

.tabela-usuarios {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 14px;
}

.tabela-usuarios th {
  padding: 18px;
  border-bottom: 1px solid var(--borda);
  color: #56647b;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}

.tabela-usuarios td {
  padding: 19px 18px;
  border-bottom: 1px solid var(--borda);
  color: #394052;
}

.tabela-usuarios tbody tr:last-child td {
  border-bottom: 0;
}

.tabela-usuarios tbody tr:hover {
  background: #f8faf7;
}

.usuario-identificacao {
  display: flex;
  align-items: center;
  gap: 12px;
}

.usuario-avatar {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #d6dcf8;
  color: #3d4a86;
  font-size: 11px;
  font-weight: 700;
}

.usuario-nome {
  color: #182033;
  font-weight: 600;
  white-space: nowrap;
}

.status-usuario {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72px;
  padding: 7px 14px;
  border-radius: 18px;
  font-size: 12px;
  white-space: nowrap;
}

.status-usuario--ativo {
  background: #e0f0e4;
  color: #07563f;
}

.status-usuario--inativo {
  background: #e7e8eb;
  color: #4b5260;
}

.paginacao {
  min-height: 72px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid var(--borda);
}

.paginacao__resumo {
  color: var(--texto-secundario);
  font-size: 13px;
}

.paginacao__controles {
  display: flex;
  align-items: center;
  gap: 12px;
}

.paginacao__botao {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid var(--borda);
  border-radius: 8px;
  background: #ffffff;
  color: var(--verde-marca);
}

.paginacao__botao:hover:not(:disabled) {
  background: var(--verde-suave);
}

.paginacao__botao:disabled {
  opacity: 0.4;
}

.paginacao__atual {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #0a1027;
  color: #ffffff;
  font-size: 14px;
}

.paginacao__total {
  color: var(--texto-secundario);
  font-size: 13px;
}

.estado-requisicao {
  min-height: 280px;
  padding: 40px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  text-align: center;
  color: var(--verde-marca);
}

.estado-requisicao p {
  margin-bottom: 0;
  line-height: 1.6;
}

.estado-requisicao--erro {
  color: #a12626;
}

.icone-carregando {
  animation: girar 900ms linear infinite;
}

@keyframes girar {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .icone-carregando {
    animation: none;
  }
}

@media (max-width: 1100px) {
  .filtros-usuarios {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .campo--busca {
    grid-column: 1 / -1;
  }
}

@media (max-width: 500px) {
  .filtros-usuarios {
    grid-template-columns: minmax(0, 1fr);
  }

  .paginacao {
    flex-direction: column;
  }
}

.acoes-pagina,
.formulario-acoes {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12px;
}

.formulario {
  padding: 28px;
}

.formulario fieldset {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}

.formulario legend {
  margin-bottom: 24px;
  padding: 0;
  font-size: 20px;
  font-weight: 700;
}

.formulario-grade,
.detalhes-grade {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
}

.formulario .campo input {
  width: 100%;
  min-height: 46px;
  padding: 12px 14px;
  border: 1px solid var(--borda);
  border-radius: 8px;
  background: #f9fafb;
  color: #242a3a;
}

.formulario .campo select {
  min-height: 46px;
  background: #f9fafb;
}

.formulario fieldset:disabled {
  opacity: 0.65;
}

.formulario-acoes {
  margin-top: 28px;
}

.erro-campo {
  color: #a12626;
  font-size: 13px;
  line-height: 1.5;
}

.formulario>.erro-campo {
  margin-top: 24px;
}

.usuario-link {
  text-decoration: none;
}

.usuario-link:hover {
  color: var(--verde-principal);
  text-decoration: underline;
}

.detalhes-grade {
  margin: 24px 0 0;
}

.detalhes-grade dt {
  margin-bottom: 8px;
  color: var(--texto-secundario);
  font-size: 13px;
  font-weight: 600;
}

.detalhes-grade dd {
  margin: 0;
  overflow-wrap: anywhere;
  color: #242a3a;
  line-height: 1.6;
}

.detalhes-confirmacao {
  color: var(--verde-marca);
  font-size: 13px;
}

@media (max-width: 700px) {

  .formulario-grade,
  .detalhes-grade {
    grid-template-columns: minmax(0, 1fr);
  }

  .formulario {
    padding: 22px;
  }
}

.botao--perigo {
  border-color: #b42332;
  background: #ffffff;
  color: #a12626;
}

.botao--perigo:hover:not(:disabled) {
  background: #fff0f1;
}

.area-desativacao {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid var(--borda);
}

.confirmacao-desativacao {
  padding: 22px;
  border: 1px solid #ebbdc2;
  border-radius: 8px;
  background: #fff7f7;
}

.confirmacao-desativacao h2 {
  margin-bottom: 10px;
  font-size: 18px;
}

.confirmacao-desativacao p {
  line-height: 1.6;
}

.botao:disabled {
  opacity: 0.6;
}

.entrada {
  width: 100%;
  min-height: 44px;
  padding: 10px 14px;
  border: 1px solid #b8c0bb;
  border-radius: 8px;
  background: #ffffff;
  color: #242a3a;
}

.filtros-condominios {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180px;
  gap: 18px;
  margin-bottom: 22px;
}

.secao-formulario {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid var(--borda);
}

.secao-formulario h2 {
  font-size: 20px;
}

.lista-torres {
  display: grid;
  gap: 16px;
}

.torre-linha {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: end;
  gap: 16px;
}

.torre-linha>span {
  padding-bottom: 12px;
  color: var(--texto-secundario);
  font-size: 13px;
}

.indicadores {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.indicador {
  padding: 24px;
  display: grid;
  gap: 8px;
}

.indicador strong {
  color: var(--verde-marca);
  font-size: 26px;
}

.indicador span {
  color: var(--texto-secundario);
  font-size: 14px;
}

.torres-resumo {
  display: grid;
  gap: 12px;
  padding: 0;
  list-style: none;
}

.torres-resumo li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding: 16px;
  border: 1px solid var(--borda);
  border-radius: 8px;
}

.torres-resumo span {
  color: var(--texto-secundario);
  font-size: 13px;
}

@media (max-width: 700px) {

  .filtros-condominios,
  .indicadores,
  .torre-linha {
    grid-template-columns: minmax(0, 1fr);
  }

  .torre-linha {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--borda);
  }

  .torre-linha>span {
    padding-bottom: 0;
  }
}

.materiais-opcoes {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.material-opcao {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-height: 40px;
  padding: 9px 13px;
  border: 1px solid #c7d7ce;
  border-radius: 8px;
  background: #f4f8f3;
  color: var(--verde-marca);
  font-size: 14px;
  cursor: pointer;
}

.material-opcao input {
  width: 17px;
  height: 17px;
  margin: 0;
  accent-color: var(--verde-principal);
}

.material-etiqueta {
  padding: 8px 13px;
  border: 1px solid #c7d7ce;
  border-radius: 18px;
  background: #f2f8f3;
  color: var(--verde-marca);
  font-size: 13px;
}

.ponto-editor {
  margin-top: 20px;
  padding: 24px;
  border: 1px solid var(--borda);
  border-radius: 8px;
  background: #fcfdfb;
}

.ponto-editor h3 {
  margin-bottom: 0;
  font-size: 18px;
}

.subtitulo-formulario {
  margin: 24px 0 16px;
  font-size: 15px;
}

@media (max-width: 700px) {
  .ponto-editor {
    padding: 16px;
  }
}

.formulario .campo {
  margin-bottom: 18px;
}

.formulario .campo textarea {
  width: 100%;
  min-height: 150px;
  padding: 12px 14px;
  border: 1px solid var(--borda);
  border-radius: 8px;
  background: #f9fafb;
  color: #242a3a;
  resize: vertical;
  line-height: 1.6;
}

.formulario fieldset {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}

.formulario legend {
  margin-bottom: 20px;
  font-weight: 700;
}

.filtro-simples {
  margin: 24px 0;
}

.grade-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.card-conteudo {
  padding: 26px;
  overflow: hidden;
}

.card-conteudo h2 {
  margin: 22px 0 12px;
  font-size: 21px;
  overflow-wrap: anywhere;
}

.texto-resumo {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  color: var(--texto-secundario);
  line-height: 1.7;
}

.texto-preservado {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.8;
}

.aula-detalhe {
  margin-top: 16px;
  padding: 18px;
  border: 1px solid var(--borda);
  border-radius: 8px;
}

.aula-detalhe summary {
  cursor: pointer;
  color: var(--verde-marca);
  font-weight: 600;
}

.aula-detalhe p {
  margin-top: 20px;
}

.alternativa-editor {
  display: grid;
  grid-template-columns: 90px minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  margin: 12px 0;
}

.alternativa-correta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
}

.alternativa-correta input,
.preview-alternativa input {
  accent-color: var(--verde-principal);
}

.preview-quiz {
  margin-top: 24px;
}

.preview-pergunta {
  margin-bottom: 26px !important;
  padding-bottom: 20px !important;
  border-bottom: 1px solid var(--borda) !important;
}

.preview-alternativa {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 12px 0;
  line-height: 1.6;
}

.espaco-superior {
  margin-top: 24px;
}

.calendario-rolagem {
  overflow-x: auto;
}

.calendario {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  min-width: 700px;
  border-top: 1px solid var(--borda);
  border-left: 1px solid var(--borda);
}

.calendario-cabecalho,
.calendario-dia {
  border-right: 1px solid var(--borda);
  border-bottom: 1px solid var(--borda);
}

.calendario-cabecalho {
  padding: 12px;
  background: #f4f8f3;
  text-align: center;
  color: var(--verde-marca);
  font-size: 13px;
}

.calendario-dia {
  min-height: 110px;
  padding: 9px;
}

.calendario-dia--outro {
  background: #f4f4f4;
  color: #747474;
}

.calendario-evento {
  display: block;
  margin-top: 8px;
  padding: 7px;
  border-radius: 5px;
  background: #e1eddf;
  color: var(--verde-marca);
  font-size: 11px;
  line-height: 1.5;
  text-decoration: none;
  overflow-wrap: anywhere;
}

.calendario-evento:hover {
  background: #ccdec9;
}

@media (max-width: 800px) {
  .grade-cards {
    grid-template-columns: minmax(0, 1fr);
  }

  .alternativa-editor {
    grid-template-columns: minmax(0, 1fr);
