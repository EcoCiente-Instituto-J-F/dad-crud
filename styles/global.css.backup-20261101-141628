/* Layout administrativo */

.cabecalho {
  gap: 32px;
}

.perfil-link {
  text-decoration: none;
}

.perfil__avatar {
  object-fit: cover;
}

.busca-global {
  position: relative;
  width: min(100%, 570px);
}

.busca-global-campo {
  min-height: 50px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid #b5b9b5;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 3px 6px rgb(0 0 0 / 14%);
  color: #626a7a;
}

.busca-global-campo input {
  width: 100%;
  min-width: 0;
  min-height: 46px;
  border: 0;
  background: transparent;
}

.busca-global-resultados {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  left: 0;
  z-index: 10;
  padding: 8px;
  border: 1px solid var(--borda);
  border-radius: 10px;
  background: #ffffff;
  box-shadow: 0 12px 24px rgb(0 0 0 / 14%);
}

.busca-global-resultados a {
  display: block;
  padding: 12px;
  border-radius: 6px;
  color: var(--verde-marca);
  text-decoration: none;
}

.busca-global-resultados a:hover {
  background: var(--verde-suave);
}

.busca-global-resultados p {
  margin: 0;
  padding: 12px;
}

.barra-lateral {
  min-height: 750px;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 7px;
  background: var(--verde-suave);
  box-shadow: 0 3px 6px rgb(0 0 0 / 16%);
}

.barra-lateral .menu-lateral {
  width: 100%;
  min-height: auto;
  flex: 1;
  padding: 36px 12px;
  gap: 18px;
  box-shadow: none;
}

.sair-painel {
  width: 44px;
  height: 54px;
  margin: 12px 0 24px;
  display: grid;
  place-items: center;
  border: 0;
  border-top: 1px solid #80a295;
  background: transparent;
  color: var(--verde-marca);
}

.somente-leitor {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* Modal */

.modal-ecociente {
  width: min(620px, calc(100vw - 32px));
  max-height: calc(100dvh - 48px);
  padding: 30px;
  overflow-y: auto;
  border: 0;
  border-radius: 22px;
  color: #0a1027;
  box-shadow: 0 24px 70px rgb(0 0 0 / 25%);
}

.modal-ecociente::backdrop {
  background: rgb(9 24 18 / 48%);
}

.modal-cabecalho {
