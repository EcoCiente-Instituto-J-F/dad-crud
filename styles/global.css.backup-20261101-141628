/* INICIO PREVIA QUIZ */
.previa-quiz {
  width: 100%;
  min-width: 0;
}

.previa-quiz-aviso {
  padding: 10px 12px;
  border-radius: 8px;
  background: #edf5ee;
  color: #496454;
  font-size: 12px;
  line-height: 1.6;
}

.previa-quiz-titulo {
  margin: 22px 0;
  color: #064e3b;
  font-size: 19px;
}

.previa-quiz .previa-quiz-pergunta {
  min-width: 0;
  margin: 0 0 24px;
  padding: 0;
  border: 0;
}

.previa-quiz-pergunta legend {
  margin-bottom: 12px;
  padding: 0;
  color: #263345;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.previa-quiz-opcao {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 8px 0;
  padding: 12px;
  border: 1px solid #dfe6e0;
  border-radius: 8px;
  color: #394052;
  font-size: 14px;
  line-height: 1.5;
  cursor: pointer;
}

.previa-quiz-opcao input {
  flex: 0 0 auto;
  margin: 4px 0 0;
  accent-color: #0c755b;
}

.previa-quiz-opcao > span {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}

.previa-quiz-opcao small {
  flex: 0 0 auto;
  font-size: 11px;
}

.previa-quiz-opcao--correta {
  border-color: #88b99c;
  background: #edf7ef;
  color: #07563f;
}

.previa-quiz-opcao--errada {
  border-color: #dfa0aa;
  background: #fff0f2;
  color: #a12626;
}

.previa-quiz-resultado {
  display: grid;
  gap: 8px;
  padding: 16px;
  border-radius: 8px;
  background: #fff2e4;
  color: #80551e;
  font-size: 14px;
  line-height: 1.6;
}

.previa-quiz-resultado--aprovado {
  background: #e8f5eb;
  color: #07563f;
}

.previa-quiz-instrucao {
  color: #626a7a;
  font-size: 12px;
}

.previa-quiz-erros {
  padding-left: 20px;
  color: #a12626;
  font-size: 13px;
  line-height: 1.7;
}
/* FIM PREVIA QUIZ */

/* INICIO FLUXO AULAS */
.curso-resumo {
  padding: 24px;
  margin-bottom: 24px;
}
.curso-resumo-topo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 16px;
}
.curso-resumo-topo h2 {
  margin: 0;
  color: #064e3b;
  font-size: 21px;
}
.curso-descricao {
  color: #626a7a;
  font-size: 14px;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.curso-total-aulas {
  color: #0c755b;
  font-size: 13px;
  font-weight: 600;
}
.curso-lista-aulas {
  overflow: hidden;
}
.curso-lista-aulas > h2 {
  margin: 0;
  padding: 22px 24px 8px;
  color: #455267;
  font-size: 18px;
}
.aula-formulario .campo {
  margin-bottom: 20px;
}
.aula-formulario .aula-conteudo {
  min-height: 220px;
  resize: vertical;
  line-height: 1.7;
}
.aula-aviso {
  padding: 12px;
  border-radius: 8px;
  background: #edf5ee;
  color: #496454;
  font-size: 12px;
  line-height: 1.6;
}
