}

.botao-fechar {
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #626a7a;
  font-size: 26px;
}

/* Login */

.login-pagina {
  min-height: 100dvh;
  padding: 48px 5%;
  display: flex;
  align-items: center;
