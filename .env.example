# Configuração pública do frontend. Não coloque credenciais do banco aqui.
VITE_DAD_API_URL=/dad-api
VITE_AUTH_API_URL=/auth-api
VITE_CADASTRO_API_URL=/cadastro-api
VITE_SENHA_API_URL=/senha-api

# APIs locais; estes destinos são usados somente pelo proxy do Vite.
DAD_PROXY_TARGET=http://127.0.0.1:8080
AUTH_PROXY_TARGET=http://127.0.0.1:9801
CADASTRO_PROXY_TARGET=http://127.0.0.1:9090
SENHA_PROXY_TARGET=http://127.0.0.1:9809

# Desativado por padrão. Só funciona em desenvolvimento.
VITE_MODO_DEMO=false
# Ative somente depois que as respectivas rotas existirem na DAD.
VITE_CALENDARIO_OCORRENCIAS_ATIVO=false
VITE_IMPORTACAO_USUARIOS_ATIVA=false
